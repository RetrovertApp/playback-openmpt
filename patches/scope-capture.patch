 using OPLPatch = std::array<uint8, 12>;
 
+// Channel scope buffer for audio visualization
+// Ring buffer size must be power of 2 for fast masking
+inline constexpr uint32 SCOPE_BUFFER_SIZE = 2048;
+inline constexpr uint32 SCOPE_BUFFER_MASK = SCOPE_BUFFER_SIZE - 1;
+
+// Per-channel scope buffer for capturing audio waveform data. The ring advances by exactly
+// one sample per output frame whether or not the channel was mixed, so a channel that falls
+// silent scrolls silence in instead of holding its last waveform.
+struct ChannelScopeBuffer
+{
+	float samples[SCOPE_BUFFER_SIZE];  // Mono samples (post-interpolation, pre-volume)
+	uint32 writeIndex;                  // Current write position
+	uint32 passStart;                   // writeIndex when the current mixing pass began
+	bool enabled;                       // Whether capture is enabled for this channel
+
+	void Reset()
+	{
+		writeIndex = 0;
+		passStart = 0;
+		enabled = false;
+		std::memset(samples, 0, sizeof(samples));
+	}
+
+	void Write(float sample)
+	{
+		samples[writeIndex & SCOPE_BUFFER_MASK] = sample;
+		writeIndex++;
+	}
+
+	void BeginPass()
+	{
+		passStart = writeIndex;
+	}
+
+	// Pads the pass to `count` frames with silence: frames the mixer skipped this pass
+	// (channel not playing, paused, or its sample ended part-way) still advance the ring.
+	void EndPass(uint32 count)
+	{
+		const uint32 written = writeIndex - passStart;
+		for(uint32 n = written; n < count; n++)
+		{
+			Write(0.0f);
+		}
+	}
+};
+
 OPENMPT_NAMESPACE_END
